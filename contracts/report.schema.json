{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "学习进度上报（report.v0.2）",
  "version": "0.2.0",
  "description": "学伴每节课结束向课程 MCP 服务上报一次，只含统计字段。不上报：聊天原文、问题原文、题干与答案原文、错题本条目、讲解偏好、自述基础、误区证据、遗忘参数、精确掌握概率、逐条事件与精确时间戳（任务书 4.4）。两档：standard 含下表全部字段，minimal 只含课节进度与各知识点状态。",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "course_id",
    "course_version",
    "session_id",
    "tier",
    "period",
    "progress",
    "kp_stats"
  ],
  "properties": {
    "schema_version": {
      "const": "report.v0.2",
      "description": "上报格式版本；服务端据此选择校验规则。"
    },
    "contract_version": {
      "type": "string",
      "description": "生成该报告时使用的契约版本，便于服务端判断是否需要迁移。"
    },
    "workbench_version": {
      "type": "string",
      "description": "学生工作台版本，用于排错。"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "报告唯一 ID（小写 UUID），服务端据此去重；离线补报沿用原 ID。"
    },
    "course_id": {
      "type": "string",
      "pattern": "^[A-Z]{3,4}$"
    },
    "course_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "学生当前固定的课程版本（tag），如 v0.1.0。"
    },
    "session_id": {
      "type": "string",
      "pattern": "^S[0-9]{2}$"
    },
    "tier": {
      "enum": [
        "standard",
        "minimal"
      ],
      "description": "上报档位。standard 为默认，minimal 只保留进度与知识点状态。"
    },
    "period": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "description": "统计时段，精确到日；不上报精确时间戳。",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": [
        "pages_total",
        "pages_done"
      ],
      "properties": {
        "pages_total": {
          "type": "integer",
          "minimum": 0
        },
        "pages_done": {
          "type": "integer",
          "minimum": 0
        },
        "warmup_branch": {
          "enum": [
            "direct",
            "remedial",
            "diagnostic",
            "skipped"
          ],
          "description": "本讲 warm-up 的分流去向：直接进核心 / 插短补习 / 先做诊断 / 未做。"
        },
        "study_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400,
          "description": "本节有效学习时长（秒），上限一天。"
        }
      },
      "additionalProperties": false
    },
    "kp_stats": {
      "type": "array",
      "description": "每个知识点一条；服务端聚合时只取每名学生在该知识点上的最新一条。",
      "items": {
        "type": "object",
        "required": [
          "kp_id",
          "state"
        ],
        "properties": {
          "kp_id": {
            "type": "string",
            "pattern": "^KP-[A-Z]{3,4}-[0-9]{3}$"
          },
          "state": {
            "enum": [
              "unseen",
              "gap",
              "partial",
              "transfer"
            ],
            "description": "四档状态，判定阈值见任务书 4.3。"
          },
          "mastery_band": {
            "enum": [
              "low",
              "mid",
              "high"
            ],
            "description": "掌握概率区间，不上报精确掌握概率。"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "correct_alone": {
            "type": "integer",
            "minimum": 0
          },
          "correct_with_hint": {
            "type": "integer",
            "minimum": 0
          },
          "wrong": {
            "type": "integer",
            "minimum": 0
          },
          "hint_level_max": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "transfer_attempts": {
            "type": "integer",
            "minimum": 0
          },
          "transfer_correct": {
            "type": "integer",
            "minimum": 0
          },
          "misconceptions": {
            "type": "array",
            "description": "误区编码出现次数；编码取自 knowledge_points.yaml 登记表。",
            "items": {
              "type": "object",
              "required": [
                "code",
                "count"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^(MIS-[A-Z]{3,4}-[0-9]{3}-[0-9]{2}|other)$"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "questions": {
            "type": "integer",
            "minimum": 0
          },
          "questions_open": {
            "type": "integer",
            "minimum": 0
          },
          "reviews_due": {
            "type": "integer",
            "minimum": 0
          },
          "reviews_done": {
            "type": "integer",
            "minimum": 0
          },
          "duration_s": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600,
            "description": "该知识点的用量（秒）。上报层钳到 600：本地事件可记录真实时长，上报时超过 600 一律记 600，避免用极端值推断学生作息。"
          }
        },
        "additionalProperties": false
      }
    },
    "content_gaps": {
      "type": "array",
      "description": "课件中找不到答案的提问，按页面聚合计数（standard 档才有）。",
      "items": {
        "type": "object",
        "required": [
          "page_id",
          "kp_id",
          "count"
        ],
        "properties": {
          "page_id": {
            "type": "string",
            "pattern": "^PG-S[0-9]{2}-[0-9]{3}$"
          },
          "kp_id": {
            "type": "string",
            "pattern": "^KP-[A-Z]{3,4}-[0-9]{3}$"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "overlay_stats": {
      "type": "object",
      "description": "本节的个性化补充情况（standard 档才有）。",
      "required": [
        "generated",
        "degraded_to_hint"
      ],
      "properties": {
        "generated": {
          "type": "integer",
          "minimum": 0
        },
        "degraded_to_hint": {
          "type": "integer",
          "minimum": 0,
          "description": "覆盖校验未通过、降级为提示的次数。"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "tier": {
            "const": "minimal"
          }
        },
        "required": [
          "tier"
        ]
      },
      "then": {
        "description": "minimal 档：只保留进度与知识点状态，剔除所有统计明细。",
        "properties": {
          "content_gaps": false,
          "overlay_stats": false,
          "kp_stats": {
            "items": {
              "properties": {
                "mastery_band": false,
                "attempts": false,
                "correct_alone": false,
                "correct_with_hint": false,
                "wrong": false,
                "hint_level_max": false,
                "transfer_attempts": false,
                "transfer_correct": false,
                "misconceptions": false,
                "questions": false,
                "questions_open": false,
                "reviews_due": false,
                "reviews_done": false,
                "duration_s": false
              }
            }
          }
        }
      }
    }
  ]
}
