{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "materials/manifest.yaml",
  "type": "object",
  "required": [
    "version",
    "pages"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "kp"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PG-S[0-9]{2}-[0-9]{3}$"
          },
          "file": {
            "type": "string"
          },
          "kp": {
            "type": "string",
            "pattern": "^KP-[A-Z]{3,4}-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
